generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
}

enum Role{
 User
 Admin
 }

 enum status {
  Pending
  Confirmed
  Cancelled
 }

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  role Role @default(User)

  bookings Booking[]
}

model Destination {
  id Int @id @default(autoincrement())
  city String
  country String
  description String
  image String
  latitude String
  longitude String.

  places Place[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Place {
  id Int @id @default(autoincrement())
  name String
  description String
  image String
  category String
  latitude String?
  longitude String?

  destinationId Int
  destination Destination @relation(fields: [destinationId], references: [id])

  tours TourPlace[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog{
  id Int @id @default(autoincrement())
  title String
  description String
  image String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tour {
  id Int @id @default(autoincrement())
  name String 
  description String
  price Int
  image String
  duration Int

  destinationId Int
  destination Destination @relation(fields: [destinationId], references: [id])

  places TourPlace[]
  bookings Booking[]
}

model TourPlace {
  tourId Int
  placeId Int

  tour Tour @relation(fields: [tourId], references: [id])
  place Place @relation(fields: [placeId], references: [id])

  @@id([tourId, placeId])
}

model Booking {
  id Int @id @default(@autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id])

  tourId Int
  tour Tour @relation(fields: [tourId], references: [id])

  date DateTime
  travelers Int
  totalPrice Int
  status String @default("Pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}