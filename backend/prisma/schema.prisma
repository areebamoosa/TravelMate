generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
}

enum Role{
 User
 Admin
 }

model User {
  id Int @id @default(autoincrement())
  email String @unique
  password String
  role Role @default(User)
}

model Destination {
  id Int @id @default(autoincrement())
  city String
  country String
  description String
  image String
  latitude String
  longitude String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}